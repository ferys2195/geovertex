# =====================================================================
# GEOVERTEX SAAS — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# =====================================================================

# ---------------------------------------------------------------------
# 1. SUPABASE CLOUD CONFIGURATION (Required for Auth & PostGIS DB)
# ---------------------------------------------------------------------
# URL Proyek Supabase Anda (Dapatkan dari Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Kunci Anonim Publik Supabase (Dapatkan dari Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---------------------------------------------------------------------
# 2. APPLICATION & OAUTH CONFIGURATION
# ---------------------------------------------------------------------
# URL Aplikasi Utama (Gunakan http://localhost:3000 untuk lokal atau URL Vercel untuk produksi)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------
# 3. DEVELOPER DEMO MODE CONFIGURATION (Optional Guard)
# ---------------------------------------------------------------------
# Atur ke 'true' jika ingin mengaktifkan tombol "Masuk Mode Pengembang" di lingkungan produksi.
# Secara default 'false' pada lingkungan produksi (hanya aktif saat npm run dev).
NEXT_PUBLIC_ALLOW_DEMO_MODE=false
